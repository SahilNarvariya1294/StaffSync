# MongoDB connection string
# Example for local MongoDB: mongodb://127.0.0.1:27017/staffsync
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/staffsync?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/staffsync"

# JWT Secret for signing authentication tokens
JWT_SECRET="staffsync_super_secret_jwt_key_2026_change_in_production"

# Port configuration (default 3000)
PORT=3000

# Node Environment
NODE_ENV="development"
